# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Env & secrets (keep example files committed)
.env*
!.env.example
!**/.env.example

# Tooling / build / Supabase CLI
.supabase/
.temp/
.next/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Firebase Android config (do not commit; use EAS secrets / local copy)
google-services.json
**/google-services.json

# Android local build / signing (prebuild or bare) — do not blanket-ignore *.json (breaks app.json)
**/android/app/build/
**/android/build/
**/android/.gradle/
**/android/local.properties
*.keystore
!debug.keystore