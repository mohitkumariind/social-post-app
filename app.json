{
  "expo": {
    "name": "Social Post",
    "slug": "social-post-new",
    "scheme": "socialbot",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Save and share your posts to the photo library",
        "NSPhotoLibraryAddUsageDescription": "Save posters to your photo library",
        "NSCameraUsageDescription": "Use camera for profile and content"
      }
    },
    "android": {
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.mohit.socialpost.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#25D366"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-firebase/app",
      "expo-dev-client",
      "expo-font",
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Save and share your posters to the photo library",
          "savePhotosPermission": "Save posters to the photo library",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "googleWebClientId": "309496298521-recmd3pe2d6g2cqhkmc86g9ha7dffntn.apps.googleusercontent.com",
      "eas": {
        "projectId": "8445ac4b-11a5-4ae5-bc3c-d60e3b921b40"
      }
    },
    "owner": "poojamohit"
  }
}
