# Add these to .env.local for Supabase connection
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin: profiles API, storage uploads, Expo broadcast (/api/notifications/send)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: higher Expo Push rate limits (https://expo.dev/accounts/[account]/settings/access-tokens)
# EXPO_ACCESS_TOKEN=
